# Copy to config.env and fill in. config.env is gitignored: it holds a password
# hash source and your SSH public key, so keep it out of the repo.

# Account created on the installed machine (also the sudo user).
USERNAME=zaq
PASSWORD='change-me'            # hashed with openssl passwd -6 at build time
FULL_NAME='Your Name'            # git user.name
EMAIL='you@example.com'          # git user.email

HOSTNAME=mini-haos
TIMEZONE=America/New_York
KB_LAYOUT=us

# Disk that will be WIPED on the target machine, and its exact size in bytes.
# Get the size with:  lsblk -bdno SIZE /dev/sda   (from a live ISO or spec sheet)
# Mac mini (Late 2014) 256 GB Apple SSD SM0256F: 251000193024
TARGET_DISK=/dev/sda
TARGET_DISK_BYTES=251000193024

# SSH public key placed in ~/.ssh/authorized_keys; sshd is enabled on first boot
# and ufw opens port 22. This is how bin/provision.sh reaches the box.
SSH_PUBKEY=~/.ssh/id_ed25519.pub

# Optional: join a tailnet on first boot (reusable, pre-authorized key).
TAILSCALE_AUTHKEY=

# Omarchy release to download and write to the stick.
OMARCHY_VERSION=4.0.4
