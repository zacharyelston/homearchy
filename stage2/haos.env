# Home Assistant VM parameters used by stage2/setup.sh
HAOS_VERSION=18.3
VM_NAME=homeassistant
VM_RAM_MB=4096
VM_VCPUS=2
VM_DISK_SIZE=32G
BRIDGE_NAME=br0
LIBVIRT_NET=host-bridge

# USB devices passed through to the VM, space-separated vendor:product IDs (e.g. a Zigbee/Z-Wave dongle).
# Applied by stage2/setup.sh, idempotently; a device that is not plugged in is skipped (re-run stage2 later).
# The VM still boots if it is unplugged (startupPolicy=optional). Find IDs with: bin/zigbee-probe.sh --list
#   10c4:ea60  SONOFF Dongle Lite MG21 (CP210x USB-serial bridge; the ID is shared by other CP210x adapters)
HAOS_USB_HOSTDEVS="10c4:ea60"
